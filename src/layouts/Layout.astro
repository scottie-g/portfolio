---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Scott Grant — Product Marketing Manager" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title === "Home" ? "Scott Grant" : `${title} — Scott Grant`}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header>
      <nav>
        <a href="/" class="site-name">Scott Grant</a>
        <ul>
          <li><a href="/portfolio">Work</a></li>
          <li><a href="/blog">Writing</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>&copy; {new Date().getFullYear()} Scott Grant</p>
    </footer>
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: #111;
    background: #fff;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    max-width: 100%;
    display: block;
  }

  header {
    border-bottom: 1px solid #e5e7eb;
    padding: 1.25rem 0;
  }

  nav {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .site-name {
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.01em;
  }

  nav ul {
    list-style: none;
    display: flex;
    gap: 2rem;
  }

  nav ul a {
    font-size: 0.9rem;
    color: #555;
    transition: color 0.15s;
  }

  nav ul a:hover {
    color: #111;
  }

  main {
    max-width: 760px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }

  footer {
    border-top: 1px solid #e5e7eb;
    padding: 2rem 0;
    text-align: center;
    font-size: 0.85rem;
    color: #999;
  }
</style>
