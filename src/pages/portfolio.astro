---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Work">
  <h1>Work</h1>
  <p class="intro">A selection of product marketing projects — launches, campaigns, and positioning work.</p>

  <div class="projects">
    <article class="project">
      <span class="tag">Product Launch</span>
      <h2>Project Title</h2>
      <p>A brief description of the project, the challenge, and the outcome. What was the product, who was the audience, and what did you achieve?</p>
      <p class="meta">Company &middot; 2024</p>
    </article>

    <article class="project">
      <span class="tag">Positioning</span>
      <h2>Project Title</h2>
      <p>A brief description of the project, the challenge, and the outcome. What was the product, who was the audience, and what did you achieve?</p>
      <p class="meta">Company &middot; 2023</p>
    </article>

    <article class="project">
      <span class="tag">Campaign</span>
      <h2>Project Title</h2>
      <p>A brief description of the project, the challenge, and the outcome. What was the product, who was the audience, and what did you achieve?</p>
      <p class="meta">Company &middot; 2023</p>
    </article>
  </div>
</Layout>

<style>
  h1 {
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .intro {
    color: #666;
    margin-bottom: 3rem;
    font-size: 1rem;
  }

  .projects {
    display: flex;
    flex-direction: column;
  }

  .project {
    padding: 2rem 0;
    border-bottom: 1px solid #e5e7eb;
  }

  .project:first-child {
    border-top: 1px solid #e5e7eb;
  }

  .tag {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #999;
    display: block;
    margin-bottom: 0.5rem;
  }

  .project h2 {
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    letter-spacing: -0.01em;
  }

  .project p {
    color: #555;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .meta {
    margin-top: 0.75rem;
    font-size: 0.82rem !important;
    color: #aaa !important;
  }
</style>
